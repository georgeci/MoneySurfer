#!/bin/sh
# Rejects any push that rewrites remote history (i.e. every force push),
# whoever runs it — human, AI agent, script or IDE.
#
# Enable once per clone (shared by all worktrees):
#   git config core.hooksPath .githooks
#
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>

z40=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	# Branch deletion or brand-new remote branch — nothing to rewrite.
	[ "$local_sha" = "$z40" ] && continue
	[ "$remote_sha" = "$z40" ] && continue

	if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
		echo "pre-push: remote commit $remote_sha for $remote_ref is unknown locally." >&2
		echo "          Run 'git fetch' and try again — refusing to push blind." >&2
		status=1
		continue
	fi

	# Fast-forward: the remote tip is an ancestor of what we are pushing.
	if git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
		continue
	fi

	echo "pre-push: refusing to force push $local_ref -> $remote_ref" >&2
	echo "          This would drop commits already on the remote ($remote_sha)." >&2
	echo "          Force pushing is forbidden in this repo under any circumstances." >&2
	echo "          Rebase onto the remote branch or open a new branch instead." >&2
	status=1
done

exit $status
