<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Financial data must never leave the device via Google Auto Backup or
        device-to-device transfer: the Room DBs (moneysurfer.db, moneysurfer_sync.db)
        and the DataStore prefs (moneysurfer_settings.preferences_pb) are stored
        unencrypted. Keeping allowBackup="false" matches the offline flavor's posture
        for the same dataset.
    -->
    <application
        android:name=".MoneySurferApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:taskAffinity=""
        android:theme="@style/Theme.MoneySurfer">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MoneySurfer.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
