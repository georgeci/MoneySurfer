// v2.3.0 — 2026-07-20
rules_version = '2';

// Workspace-scoped tenancy: every per-user document lives under
// /workspaces/{wid}/... and is gated by membership. The workspace owner can
// add/remove members. Personal user docs live under /users/{uid}.
//
// Soft-delete only — entity collections explicitly enumerate `create, update`
// and omit `delete`. Clients must `update` with `deletedAt` set instead.
// Tombstones are pulled by other devices via the cursor-based pull
// (see sync.md §4.4).
//
// The ONE exception is account deletion (issue #213): the repo has no Cloud
// Functions, so the client itself must be able to purge the user's remote
// footprint. Owners may hard-delete workspace docs + subcollection docs, and
// a user may hard-delete their own /users/{uid} and userEmails mapping. The
// app only exercises this for workspaces with no other ACTIVE member; the
// regular sync path still writes tombstones, never deletes.
//
// Known asymmetry, accepted deliberately — read before loosening or tightening:
//  1. The "no other ACTIVE member" condition lives ONLY in the client
//     (UserAccountDeletionRepositoryImpl). It is not expressible here: rules
//     can `get()`/`exists()` a known document path but cannot query or count a
//     collection, so "does any OTHER member row have status ACTIVE" has no
//     rules-side formulation at any price.
//  2. A hard-delete leaves no tombstone, so it does NOT propagate — a device
//     holding a replica never learns the doc is gone (it just stops being
//     pulled). That is harmless for the flow the app performs: a purge only
//     targets a workspace where nobody else is ACTIVE, and a LEFT/REMOVED
//     member already fails isMember() and cannot read the workspace at all, so
//     no live replica is left to go stale. The deleting user's own other
//     devices keep their local copy by design (stated on the hosted
//     account-deletion page).
//  3. Residual risk is therefore a MODIFIED client hard-deleting a genuinely
//     shared workspace it owns: co-members' replicas would keep rows the
//     server no longer has. Bounded by ownership — other households are
//     untouchable — and no worse in reach than the `deletedAt` mass-update an
//     owner could always perform. Closing it properly needs a server-side
//     deletion path (Cloud Functions); revisit if one is ever deployed.
//
// Server-side app-version gate: every entity write must carry a
// `clientVersionCode` int >= MIN_CLIENT_VERSION_CODE. Rejects pushes from
// builds older than the published cutoff so the data layer is never written
// in a deprecated shape (see block.md §10).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Membership grants read/write to every workspace subcollection, so it must track
    // ACTIVE status — not mere row existence. Member rows are soft-deleted (status
    // LEFT / REMOVED, never hard-deleted), so an existence check would keep granting a
    // left or owner-evicted user full access to accounts/transactions/etc. `exists()`
    // guards the `get()`; a missing `status` (pre-status legacy docs) defaults to ACTIVE
    // so those keep working. Same-path get()/exists() are billed as a single read.
    function isMember(wid) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid))
             .data.get('status', 'ACTIVE') == "ACTIVE";
    }

    function isOwner(wid) {
      return signedIn()
        && get(/databases/$(database)/documents/workspaces/$(wid)).data.ownerId == request.auth.uid;
    }

    // True when the member doc being created points (via its own `inviteId` field)
    // at an owner-issued invite in the SAME workspace that admits the caller and is
    // still joinable. This is what gates invite-less self-join (issue #152): only the
    // workspace owner can mint an invite (see the invites block), so a stranger who
    // merely learns a workspace id has no invite to point at and cannot fabricate one.
    // `exists()` guards the `get()` so a missing/dangling id denies rather than errors.
    function hasJoinableInvite(wid) {
      return 'inviteId' in request.resource.data
        && request.resource.data.inviteId is string
        && exists(/databases/$(database)/documents/workspaces/$(wid)/invites/$(request.resource.data.inviteId))
        && inviteAdmitsCaller(
             get(/databases/$(database)/documents/workspaces/$(wid)/invites/$(request.resource.data.inviteId)).data
           );
    }

    // An invite admits the caller when it is still joinable and addresses them.
    //  - Joinable = PENDING, or already ACCEPTED. ACCEPTED is allowed so the member
    //    create still passes if the invitee's own PENDING→ACCEPTED flip lands first
    //    (push order is not guaranteed) or on an idempotent outbox retry. CANCELLED /
    //    DECLINED invites are excluded — a revoked invite must not grant membership.
    //  - Addresses the caller by uid (targetUserId) or, for legacy/email-only invites,
    //    by a case-insensitive email match. Email accesses are type-guarded because a
    //    token may carry no `email` claim (anon / Hide-My-Email) and `.lower()` on null
    //    aborts the whole rule.
    function inviteAdmitsCaller(invite) {
      return invite.status in ["PENDING", "ACCEPTED"]
        && (
             invite.targetUserId == request.auth.uid
          || (invite.email is string
              && request.auth.token.email is string
              && invite.email.lower() == request.auth.token.email.lower())
        );
    }

    // Server-side floor for `clientVersionCode`. Static — bump in lockstep with
    // `appConfig/mobile.minSupportedAppVersionCode` when retiring an old build.
    // Real force-update enforcement lives client-side in `AppVersionGate`; this
    // is a backstop that prevents pre-`MIN_CLIENT_VERSION_CODE` payloads from
    // landing in Firestore.
    function hasValidClientVersion() {
      return request.resource.data.clientVersionCode is int
        && request.resource.data.clientVersionCode >= 1;
    }

    // ── Entity write-shape validation (issue #156) ────────────────────────────
    // Poison-document guard. Entity docs are pulled and run through
    // kotlinx-serialization `decode()` on every co-member's device. Before this
    // guard the write rules validated only membership + `clientVersionCode`, never
    // field types — so any member could write a wrong-typed field (e.g.
    // `amount: "abc"` where the DTO expects a Long). On the next pull `decode()`
    // threw and aborted the whole batch BEFORE the cursor advanced past the doc,
    // so every co-member re-fetched it and failed forever: a workspace-wide sync
    // outage (poison-message crash loop). These functions reject the malformed
    // write at the source. The client also skips-and-logs an undecodable doc as a
    // second line of defence (see PluginHelpers.decodeOrNull) for docs written by
    // older builds or already in the store.
    //
    // Contract: each field is type-checked ONLY when present. The wire format
    // omits fields left at their DTO default (see data-remote/.../RemoteDtos.kt),
    // so a minimal doc that carries just the fields it needs must still pass — we
    // reject only a field that is present with the wrong type. `.get(f, <default>)`
    // returns the typed default when the key is absent (so absence passes) and the
    // stored null when the key is present-but-null (nullable helpers allow that).
    // Field lists mirror the DTOs in RemoteDtos.kt — keep them in lockstep when a
    // DTO field is added or its type changes.
    //
    // Note: this subsumes the deprecated tracker bug #6 (`request.resource.data.workspaceId == wid`).
    // That check is a no-op here — the wire DTOs carry NO `workspaceId` field; the
    // workspace id is taken from the trusted document path and injected at decode
    // time (scopeKey), so there is nothing on the payload to spoof or validate.
    // See docs/architecture/firestore-rules-bugs.md #6.
    function typeIntOk(data, f)  { return data.get(f, 0) is int; }
    function typeStrOk(data, f)  { return data.get(f, '') is string; }
    function typeBoolOk(data, f) { return data.get(f, false) is bool; }
    function typeNullableIntOk(data, f) {
      return data.get(f, 0) == null || data.get(f, 0) is int;
    }
    function typeNullableStrOk(data, f) {
      return data.get(f, '') == null || data.get(f, '') is string;
    }

    // AccountDoc — data-remote/.../RemoteDtos.kt
    function hasValidAccountShape(data) {
      return typeStrOk(data, 'name')
        && typeStrOk(data, 'type')
        && typeStrOk(data, 'currency')
        && typeIntOk(data, 'balance')
        && typeBoolOk(data, 'archived')
        && typeIntOk(data, 'updatedAt')
        && typeNullableIntOk(data, 'deletedAt');
    }

    // CategoryDoc — data-remote/.../RemoteDtos.kt
    function hasValidCategoryShape(data) {
      return typeStrOk(data, 'name')
        && typeStrOk(data, 'type')
        && typeNullableStrOk(data, 'parentId')
        && typeIntOk(data, 'createdAt')
        && typeIntOk(data, 'updatedAt')
        && typeNullableIntOk(data, 'deletedAt')
        && typeNullableStrOk(data, 'systemKind');
    }

    // TransactionDoc — data-remote/.../RemoteDtos.kt
    function hasValidTransactionShape(data) {
      return typeStrOk(data, 'accountId')
        && typeNullableStrOk(data, 'categoryId')
        && typeIntOk(data, 'amount')
        && typeStrOk(data, 'currencyCode')
        && typeStrOk(data, 'note')
        && typeIntOk(data, 'operationAt')
        && typeStrOk(data, 'operationDate')
        && typeStrOk(data, 'type')
        && typeStrOk(data, 'status')
        && typeIntOk(data, 'createdAt')
        && typeIntOk(data, 'updatedAt')
        && typeNullableIntOk(data, 'deletedAt')
        && typeNullableStrOk(data, 'transferId');
    }

    // Personal user document — workspace pointers, profile metadata.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      // Self-delete only — the last remote write of the account-deletion flow
      // before the Firebase Auth user itself is deleted (issue #213).
      allow delete: if signedIn() && request.auth.uid == uid;

      // Any signed-in user may append one workspace ID to `invitedWorkspaceIds`.
      // Used by the invite sender to seed the recipient's discovery list so the
      // recipient's next syncAll() finds the invite without a collectionGroup query.
      //
      // Guards:
      //  - only `invitedWorkspaceIds` may change (affectedKeys),
      //  - only additions are allowed — new list must contain all existing elements
      //    (hasAll prevents a sender from removing other senders' entries),
      //  - max one new entry per call (size cap closes list-flooding DoS),
      //  - total list capped at 100 (guards against accumulated spam).
      // Removals (accept / decline cleanup) go through the owner rule above.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedWorkspaceIds'])
        && request.resource.data.invitedWorkspaceIds.hasAll(resource.data.invitedWorkspaceIds)
        && request.resource.data.invitedWorkspaceIds.size() == resource.data.invitedWorkspaceIds.size() + 1
        && request.resource.data.invitedWorkspaceIds.size() <= 100;
    }

    // email→uid lookup table for invite targetUserId resolution.
    // Doc id = lowercased email. Single-doc reads only (clients call .get() on the
    // exact email key); writes restricted to the owner of the uid being mapped AND
    // to the email key matching that user's Firebase Auth email claim. The email-key
    // binding closes an email-squatting hole: without it any signed-in user could
    // pre-write `userEmails/victim@example.com → my_uid` and steal invites addressed
    // to the victim until the victim's own login overwrote the mapping.
    match /userEmails/{email} {
      // Single-key get is the invite email→uid lookup (SendInviteUseCase). This is
      // a known, ACCEPTED LOW existence oracle (issue #161): an authed user can
      // probe one exact address at a time. Not closed by a server callable because
      // that would require denying this `get` — a rules-access-control change — and
      // the repo has no Cloud Functions deployment; the escalation path is already
      // shut by the invite-gated members create (rules bug #8 / issue #152). See
      // docs/architecture/firestore-rules-bugs.md #161. Do NOT loosen below.
      allow get: if signedIn();
      allow list: if false; // prevent enumeration via collection scan
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email is string
        && email == request.auth.token.email.lower();
      // Account deletion (issue #213): a user may remove the mapping that points at
      // their own uid. Gating on the stored uid (not the email claim) keeps a user
      // whose auth email changed able to clean up the old mapping, while still
      // preventing anyone from deleting another user's row.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Public read-only app config (force-update gate, see block.md).
    // Writes go through the Firebase Console.
    match /appConfig/{docId} {
      allow read: if true;
    }

    // Collection-group READ rules for `invites` — MUST be declared on the wildcard
    // path. Firestore-rules quirk: nested `match /workspaces/{wid}/invites/{...}`
    // rules do NOT enable collection-group queries; only `match /{path=**}/invites/{...}`
    // does. Without this block, recipient self-discovery via
    // `firestore.collectionGroup("invites").where("targetUserId", "==", uid)` fails
    // with "No matching allow statements" — even when the nested rule is `allow read: if true`.
    //
    // Two independent `allow read` clauses (no OR) — Firestore analyzes each in isolation
    // for collection-group query feasibility:
    //  1) targetUserId match — primary path. Pure field-equality, fully provable.
    //  2) email match — fallback for legacy invites without targetUserId. Lower-cases
    //     both sides because some legacy docs were stored mixed-case before SendInvite
    //     started normalizing. `is string` guards keep the rule from erroring on docs
    //     missing the field or tokens missing the email claim.
    //
    // Per-doc reads inside a workspace (member roster) and ALL writes still go through
    // the nested `match /workspaces/{wid}/invites/{inviteId}` block below.
    match /{path=**}/invites/{inviteId} {
      allow read: if resource.data.targetUserId == request.auth.uid;
      allow read: if resource.data.email is string
        && request.auth.token.email is string
        && resource.data.email.lower() == request.auth.token.email.lower();
    }

    match /workspaces/{wid} {
      allow get, list: if isMember(wid);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && hasValidClientVersion();
      allow update: if isOwner(wid) && hasValidClientVersion();
      // Regular flows must mark `deletedAt` via update (tombstone). The owner
      // hard-delete below exists ONLY for account deletion (issue #213); the
      // client purges all subcollection docs first, then this root doc — the
      // subcollection delete rules read this doc via isOwner(), so it must
      // outlive them.
      allow delete: if isOwner(wid);

      match /invites/{inviteId} {
        // Per-doc + per-workspace reads — workspace members can browse the invite
        // roster. Recipient self-discovery (which uses collection-group queries) is
        // handled separately by the wildcard `match /{path=**}/invites/{inviteId}`
        // block above.
        //
        // Invitee (non-member) read: AllUserData pull uses fetchInvitesForUser which
        // adds `where targetUserId == uid`. That query satisfies this rule because every
        // returned doc will have targetUserId == request.auth.uid.
        allow read: if isMember(wid);
        allow read: if resource.data.targetUserId == request.auth.uid;

        // Create: only the owner, must persist a PENDING invite stamped with their uid.
        allow create: if isOwner(wid)
          && hasValidClientVersion()
          && request.resource.data.status == "PENDING"
          && request.resource.data.invitedByUserId == request.auth.uid;

        // Update: owner can transition (PENDING → CANCELLED, etc.); the invitee can flip
        // PENDING → ACCEPTED/DECLINED on rows that target them by email or targetUserId.
        // Email match lower-cases both sides (legacy docs may not be normalized) and
        // type-guards each access — `request.auth.token.email` is null for accounts
        // without an email claim (anon, certain OAuth providers) and a raw `.lower()`
        // on null aborts the whole rule with PERMISSION_DENIED.
        //
        // Idempotent re-push: invitee may also re-write the SAME terminal status they
        // already set. Why: when the outbox retries a mutation whose first push already
        // landed (e.g. response was lost on the way back), the local doc is still
        // PENDING but the server is already ACCEPTED/DECLINED. Without this branch the
        // retry would loop forever as PERMISSION_DENIED. Cannot be exploited to flip
        // CANCELLED → ACCEPTED because we require resource.data.status to equal the
        // request status.
        allow update: if hasValidClientVersion() && (
             isOwner(wid)
          || (signedIn()
              && (
                   (resource.data.email is string
                      && request.auth.token.email is string
                      && resource.data.email.lower() == request.auth.token.email.lower())
                || resource.data.targetUserId == request.auth.uid
              )
              && (
                   (resource.data.status == "PENDING"
                      && request.resource.data.status in ["ACCEPTED", "DECLINED"])
                || (resource.data.status in ["ACCEPTED", "DECLINED"]
                      && request.resource.data.status == resource.data.status)
              ))
        );
        // Owner-only hard-delete — account-deletion purge path (issue #213).
        allow delete: if isOwner(wid);
      }

      match /members/{uid} {
        allow read: if isMember(wid);
        // Owner manages everyone (role, status=REMOVED, snapshots).
        //
        // Self-create is the accept-invite path: a signed-in user may create ONLY
        // their own row, and ONLY when they can point at an owner-issued invite that
        // admits them (`hasJoinableInvite`). Without that gate any authenticated user
        // who learned a workspace id could write their own member row and gain full
        // read/write access to another household's data — the tenant-isolation break
        // in issue #152. The owner branch is evaluated last so the invitee path never
        // needs to `get()` the (possibly not-yet-synced) parent workspace doc.
        allow create:
          if hasValidClientVersion() && (
               (request.auth.uid == uid && hasJoinableInvite(wid))
            || isOwner(wid)
          );
        // Self-writes may soft-leave (status=LEFT) or refresh profile snapshots, but
        // cannot change role and cannot flip status to REMOVED. A member the owner has
        // evicted (current status REMOVED) cannot self-resurrect — self-update is
        // blocked outright once the row is REMOVED, so rejoining requires a fresh
        // owner invite (closes the eviction-bypass called out in issue #152).
        allow update:
          if hasValidClientVersion() && (
               isOwner(wid)
            || (request.auth.uid == uid
                && resource.data.status != "REMOVED"
                && request.resource.data.role == resource.data.role
                && request.resource.data.status in ["ACTIVE", "LEFT"])
          );
        // Owner-only hard-delete — account-deletion purge path (issue #213).
        // Members leaving still soft-delete via status=LEFT above.
        allow delete: if isOwner(wid);
      }

      match /accounts/{aid} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid) && hasValidClientVersion()
          && hasValidAccountShape(request.resource.data);
        // Owner-only hard-delete — account-deletion purge path (issue #213).
        allow delete: if isOwner(wid);
      }

      match /categories/{cid} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid) && hasValidClientVersion()
          && hasValidCategoryShape(request.resource.data);
        // Owner-only hard-delete — account-deletion purge path (issue #213).
        allow delete: if isOwner(wid);
      }

      match /transactions/{tid} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid) && hasValidClientVersion()
          && hasValidTransactionShape(request.resource.data);
        // Owner-only hard-delete — account-deletion purge path (issue #213).
        allow delete: if isOwner(wid);
      }

      // budgets / recurringRules carry no wire DTO yet (no sync plugin decodes
      // them), so there is no schema to validate and no poison-document pull path.
      // Add a hasValid*Shape() guard here in lockstep when their DTOs land.
      match /budgets/{bid} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid) && hasValidClientVersion();
        // Owner-only hard-delete — account-deletion purge path (issue #213).
        allow delete: if isOwner(wid);
      }

      match /recurringRules/{rid} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid) && hasValidClientVersion();
        // Owner-only hard-delete — account-deletion purge path (issue #213).
        allow delete: if isOwner(wid);
      }
    }
  }
}
