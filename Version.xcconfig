// Shared app version. Android Gradle and iOS Xcode both read this file.
//
// The version is `major.minor.build`. Only the first two are edited by hand —
// `build` is the CI run number, injected through the APP_BUILD_NUMBER env var
// so every distributed build is distinguishable. Local builds keep the default
// below.
//
// The default below is also the local iOS build number (CURRENT_PROJECT_VERSION
// resolves to it), so it must never go down: a lower number blocks installing
// over an app already on the device. 3 is where the old static
// APP_VERSION_CODE left off.
APP_VERSION_MAJOR = 0
APP_VERSION_MINOR = 1
APP_BUILD_NUMBER = 3

// Xcode interpolates these; the Android convention plugin derives its own
// versionName / versionCode from the three parts above (xcconfig has no
// arithmetic, and Java's Properties parser doesn't expand `$(...)`).
APP_VERSION_NAME = $(APP_VERSION_MAJOR).$(APP_VERSION_MINOR).$(APP_BUILD_NUMBER)
APP_VERSION_CODE = $(APP_BUILD_NUMBER)
